{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Presentation: local preview",
      "type": "node-terminal",
      "request": "launch",
      "command": "PATH=\"${workspaceFolder}/.venv/bin:$PATH\" npm run presentation:dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Presentation ready: (http://127\\.0\\.0\\.1:4174/[^ ]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
